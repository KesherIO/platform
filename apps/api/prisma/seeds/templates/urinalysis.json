{
  "catalogItemCode": "URINALYSIS",
  "species": "ANY",
  "title": "Uroanálisis Completo",
  "defaultObservations": "Tipo de muestra: orina.",
  "observationPhrases": [
    {
      "code": "MUESTRA_INADECUADA",
      "label": "Muestra inadecuada",
      "text": "Muestra recibida en condiciones inadecuadas para su procesamiento. Resultados orientativos.",
      "sectionCode": ""
    },
    {
      "code": "REPETIR_EXAMEN",
      "label": "Repetir examen",
      "text": "Se recomienda repetir el examen con una nueva muestra.",
      "sectionCode": ""
    },
    {
      "code": "ORINA_CONCENTRADA",
      "label": "Orina concentrada",
      "text": "Orina altamente concentrada. Los valores semicuantitativos pueden estar sobreestimados.",
      "sectionCode": "QUIMICA_DE_LA_ORINA"
    },
    {
      "code": "ORINA_DILUIDA",
      "label": "Orina diluida",
      "text": "Orina diluida (densidad baja). Los valores semicuantitativos pueden estar subestimados.",
      "sectionCode": "QUIMICA_DE_LA_ORINA"
    },
    {
      "code": "PROTEINURIA",
      "label": "Proteinuria — correlacionar",
      "text": "Se detecta proteinuria. Se recomienda correlacionar con relación proteína/creatinina urinaria (UPC).",
      "sectionCode": "QUIMICA_DE_LA_ORINA"
    },
    {
      "code": "HEMATURIA",
      "label": "Hematuria — confirmar",
      "text": "Se detecta sangre en orina. Se recomienda confirmar con sedimento urinario y correlacionar clínicamente.",
      "sectionCode": "QUIMICA_DE_LA_ORINA"
    },
    {
      "code": "GLUCOSURIA",
      "label": "Glucosuria — evaluar glucemia",
      "text": "Se detecta glucosa en orina. Se recomienda evaluar glucemia para descartar diabetes mellitus u otras causas.",
      "sectionCode": "QUIMICA_DE_LA_ORINA"
    },
    {
      "code": "CRISTALES_ALMACENAMIENTO",
      "label": "Cristales por almacenamiento",
      "text": "La presencia de cristales puede estar relacionada con almacenamiento prolongado o refrigeración de la muestra.",
      "sectionCode": "EXAMEN_MICROSCOPICO"
    },
    {
      "code": "BACTERIAS_UROCULTIVO",
      "label": "Bacterias — sugerir urocultivo",
      "text": "Se observan bacterias en el sedimento. Se sugiere urocultivo y antibiograma para confirmación e identificación.",
      "sectionCode": "EXAMEN_MICROSCOPICO"
    },
    {
      "code": "CILINDROS_OBSERVADOS",
      "label": "Cilindros — daño renal",
      "text": "Se observan cilindros en el sedimento urinario. La presencia de cilindros sugiere compromiso tubular renal. Se recomienda correlacionar con perfil renal.",
      "sectionCode": "EXAMEN_MICROSCOPICO"
    },
    {
      "code": "SEDIMENTO_ACTIVO",
      "label": "Sedimento activo",
      "text": "Sedimento urinario activo con presencia de leucocitos y bacterias. Compatible con infección del tracto urinario.",
      "sectionCode": "EXAMEN_MICROSCOPICO"
    },
    {
      "code": "MUESTRA_CISTOCENTESIS",
      "label": "Muestra por cistocentesis",
      "text": "Muestra obtenida por cistocentesis.",
      "sectionCode": ""
    },
    {
      "code": "MUESTRA_CATETERIZACION",
      "label": "Muestra por cateterización",
      "text": "Muestra obtenida por cateterización uretral.",
      "sectionCode": ""
    },
    {
      "code": "MUESTRA_MICCION",
      "label": "Muestra por micción",
      "text": "Muestra obtenida por micción espontánea (chorro medio).",
      "sectionCode": ""
    }
  ],

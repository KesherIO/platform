// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantRole {
  OWNER
  ADMIN
  VET
  TECHNICIAN
  RECEPTIONIST
  MESSENGER
}

enum DeliveryMethod {
  LAB_PICKUP
  CLIENT_DELIVERY
}

enum PickupStatus {
  REQUESTED
  ASSIGNED
  NOTIFIED
  ACCEPTED
  COLLECTED
  IN_TRANSIT
  RECEIVED_AT_LAB
  CANCELLED
  FAILED
}

enum TimelineEventType {
  ORDER_CREATED
  PICKUP_REQUESTED
  PICKUP_ASSIGNED
  NOTIFICATION_SENT
  NOTIFICATION_FAILED
  PICKUP_ACCEPTED
  SAMPLE_COLLECTED
  IN_TRANSIT
  RECEIVED_AT_LAB
  PICKUP_CANCELLED
  PICKUP_FAILED
  PROBLEM_REPORTED
  PROCESSING_STARTED
  RESULTS_COMPLETED
  REPORT_RELEASED
  // Phase 3 — specimen accessioning
  SAMPLE_ACCESSIONED
  SAMPLE_ACCEPTED
  SAMPLE_REJECTED
  TEST_BLOCKED
  TEST_UNBLOCKED
  TEMPLATE_RESOLVED
}

enum OnboardingTokenType {
  ADMIN
}

enum PatientSpecies {
  DOG
  CAT
  EQUINE
  BOVINE
  BIRD
  REPTILE
  RABBIT
  OTHER
  ANY // species-agnostic template — applies to all species
}

enum AgeUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

enum CaseStatus {
  OPEN
  TRIAGED
  ORDERED
  COMPLETED
  CANCELLED
}

enum PatientSex {
  MALE
  FEMALE
  UNKNOWN
}

enum CatalogItemKind {
  TEST
  PACKAGE
}

/// How the lab result value for this test should be interpreted.
/// Nullable — not all tests have structured results yet.
/// NUMERIC: a quantity with a unit (referenceMin/Max live on ReferenceRange, keyed by species).
/// TEXT: a free-text or narrative result (e.g. culture sensitivity report).
/// POSITIVE_NEGATIVE: a qualitative yes/no result (e.g. heartworm antigen).
enum ResultType {
  NUMERIC
  TEXT
  POSITIVE_NEGATIVE
}

enum OrderStatus {
  PENDING // order placed, waiting for sample
  READY_FOR_PICKUP // clinic flagged sample as ready — courier path only
  COLLECTED // sample drawn/picked up
  RECEIVED_BY_LAB // sample physically arrived at lab
  PROCESSING // analysis underway
  COMPLETED // results available
  CANCELLED
}

enum OrderPriority {
  ROUTINE
  URGENT
  STAT
}

/// How a single analyte value should be entered and rendered.
enum AnalyteValueType {
  NUMERIC // number + unit + ref range → auto-flag H/L/N
  TEXT // single-line string (culture report, microscopy)
  LONG_TEXT // multi-line textarea (pathology narratives)
  POSITIVE_NEGATIVE // boolean rendered as Positivo / Negativo
  SELECT // fixed option list stored in options[]
}

enum ResultReportStatus {
  DRAFT // lab is entering values — not visible to clinic
  RELEASED // final and immutable — clinic can see it
}

enum KnowledgeScope {
  GLOBAL // shared across all tenants — platform-owned
  TENANT // specific to one clinic/lab
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum TenantType {
  CLINIC // veterinary clinic — creates cases and orders
  LAB // external reference laboratory
  PLATFORM // KesherIO platform tenant (singleton)
}

enum ClientType {
  VETERINARY_CLINIC
  INDEPENDENT_VET
  BREEDER
  FARM
  SHELTER
  RESEARCH_ORGANIZATION
  INDIVIDUAL
  OTHER
}

enum ClientStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// Status of a single ordered test within a lab order.
enum OrderedTestStatus {
  PENDING // created, awaiting specimen acceptance
  READY // specimen accepted, template resolved — available for processing
  IN_PROGRESS // technician has started processing
  RESULTS_ENTERED // all analyte values filled in — awaiting review
  IN_REVIEW // submitted for supervisor review
  COMPLETED // report released
  BLOCKED // cannot proceed (missing specimen, missing template, etc.)
  CANCELLED // test cancelled
}

enum SpecimenStatus {
  EXPECTED // derived from LabTestSpecimenRequirement, not yet received
  RECEIVED // physical tube logged — transitional, pending accept/reject
  ACCEPTED // usable — linked tests transition PENDING → READY
  REJECTED // unusable — linked tests transition to BLOCKED
}

enum BlockReason {
  MISSING_SPECIMEN
  REJECTED_SPECIMEN
  INSUFFICIENT_VOLUME
  ANALYZER_UNAVAILABLE
  REAGENT_UNAVAILABLE
  REQUIRES_RECOLLECTION
  MISSING_RESULT_TEMPLATE
  OTHER
}

/// How analyte values were entered for a given ordered test.
enum ResultEntryMethod {
  MANUAL // technician enters values manually
  INSTRUMENT // connected analyzer pushed data
  IMPORTED // CSV / HL7 file import
}

/// Whether an OrderedTest originated from a direct order line or a package expansion.
enum OrderedTestSourceType {
  DIRECT // test ordered as a standalone line item
  PACKAGE // test derived from a package expansion
}

enum Department {
  HEMATOLOGY
  CHEMISTRY
  URINALYSIS
  PARASITOLOGY
  SEROLOGY
  ENDOCRINOLOGY
  MICROBIOLOGY
  OTHER
}

enum ProcessingMethod {
  MANUAL
  ANALYZER
}

enum ResultEntrySource {
  MANUAL_ENTRY
  FILE_IMPORT
  DIRECT_INTEGRATION
}

enum TemplateScope {
  PLATFORM
  LABORATORY
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Auth / Multi-tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id                    String          @id @default(cuid())
  name                  String
  type                  TenantType      @default(CLINIC)
  slug                  String          @unique
  clientType            ClientType?
  clientStatus          ClientStatus?
  // Contact & clinic details — collected during onboarding clinic-setup step
  primaryContactName    String?
  address               String?
  city                  String?
  email                 String?
  phone                 String?
  phoneNumbers          Json? // [{label: "WhatsApp", number: "+1 555…"}, …]
  country               String?
  notificationMethod    String? // 'email' | 'sms'
  timezone              String          @default("UTC") // IANA name, e.g. "America/Bogota" — used to evaluate messenger schedules
  // Branding — optional, populated via future branding/settings step
  logoUrl               String? // URL to uploaded logo in storage (never store file data here)
  primaryColor          String?
  mapLat                Float?
  mapLng                Float?
  // Sample collection settings — snapshotted onto each Pickup at creation time
  pickupEnabled         Boolean         @default(false)
  defaultDeliveryMethod DeliveryMethod?
  pickupAddress         String?
  pickupContactName     String?
  pickupContactPhone    String?
  collectionHours       String?
  pickupInstructions    String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  memberships            UserTenantMembership[]
  invitations            TenantInvitation[]
  cases                  Case[]
  orders                 Order[]                    @relation("ClinicOrders")
  labOrders              Order[]                    @relation("LabOrders")
  laboratoryProfile      LaboratoryProfile?
  clinicConnections      ClinicLabConnection[]      @relation("ClinicConnections")
  labConnections         ClinicLabConnection[]      @relation("LabConnections")
  labCatalogItems        CatalogItem[]              @relation("LabCatalog")
  labPickups             Pickup[]                   @relation("LabPickups")
  clinicPickups          Pickup[]                   @relation("ClinicPickups")
  labAnalyzers           Analyzer[]                 @relation("LabAnalyzers")
  labTestConfigs         LabTestConfiguration[]     @relation("LabTestConfigs")
  labTemplateDefinitions ResultTemplateDefinition[] @relation("LabTemplateDefinitions")

  @@map("tenants")
}

model User {
  id        String   @id // Supabase Auth UUID — never auto-generate, always comes from JWT sub
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        UserTenantMembership[]
  sentInvitations    TenantInvitation[]
  createdCases       Case[]
  assignedTests      OrderedTest[]
  receivedSpecimens  Specimen[]             @relation("SpecimensReceivedBy")
  pickupsAsMessenger Pickup[]               @relation("MessengerPickups")
  pushSubscriptions  PushSubscription[]

  @@map("users")
}

model UserTenantMembership {
  userId            String
  tenantId          String
  role              TenantRole
  /// MESSENGER-only: recurring weekly availability, e.g.
  /// { MONDAY: {start:"09:00", end:"17:00"}, ..., SUNDAY: null }.
  /// Informational for now — displayed and used to sort the assign-messenger
  /// list; does not block or exclude manual assignment outside these hours.
  schedule          Json?
  /// When true, non-MESSENGER users (ADMIN, TECHNICIAN) can be assigned
  /// pickups, appear in the messenger list, access My Pickups, and receive
  /// push notifications. Ignored for MESSENGER role (intrinsic capability).
  canPerformPickups Boolean    @default(false)
  createdAt         DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId]) // composite PK — no surrogate id needed
  @@index([tenantId])
  @@index([userId])
  @@map("user_tenant_memberships")
}

/// Pending invitations sent by clinic owners/admins to bring staff onboard.
/// Token is a signed short-lived value; acceptedAt is set on acceptance.
model TenantInvitation {
  id              String     @id @default(cuid())
  tenantId        String
  email           String
  role            TenantRole
  token           String     @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation(fields: [invitedByUserId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@map("tenant_invitations")
}

/// Onboarding tokens created by KesherIO to invite clinic admins.
/// Each token is single-use and expires after 7 days.
/// On completion, the backend creates the Supabase user, Tenant, and ADMIN membership.
model OnboardingToken {
  id               String              @id @default(cuid())
  token            String?             @unique // DEPRECATED — kept for backward compat with old rows
  tokenHash        String?             @unique // SHA-256 hex of the raw token (new rows use this)
  type             OnboardingTokenType @default(ADMIN)
  clinicName       String
  clinicEmail      String // contact email for the clinic (Tenant.email)
  clientType       ClientType?
  externalClinicId String? // optional external reference from the platform
  laboratoryId     String? // lab tenant that created this invitation
  expiresAt        DateTime
  used             Boolean             @default(false)
  usedAt           DateTime?
  revokedAt        DateTime?
  createdByUserId  String?
  createdAt        DateTime            @default(now())

  @@index([token])
  @@index([tokenHash])
  @@map("onboarding_tokens")
}

// ---------------------------------------------------------------------------
// Cases
// ---------------------------------------------------------------------------

/// A veterinary lab case — the central aggregate of the platform.
/// Patient and owner data are embedded (no separate Patient table for MVP).
/// Order data is embedded as JSON (one order per case for MVP).
/// All case data is scoped to a tenant — cross-tenant access is impossible
/// because every lookup includes tenantId in the WHERE clause.
model Case {
  id       String     @id @default(cuid())
  tenantId String
  status   CaseStatus @default(OPEN)

  // Patient — embedded (no separate Patient table for MVP)
  patientName        String
  patientSpecies     PatientSpecies
  patientSex         PatientSex?
  patientBreed       String?
  patientDateOfBirth DateTime? // used when exact DOB is known; age/ageUnit are the fallback
  patientAge         Int?
  patientAgeUnit     AgeUnit?
  patientWeight      Float? // kilograms

  // Owner
  ownerName  String
  ownerPhone String?

  // Clinical inputs
  symptoms                String? // free-text symptom description (textarea)
  triageResult            Json? // AI DDx output: { diagnoses: [...], suggestedCatalogItemIds: [...] }
  suggestedCatalogItemIds String[] // AI-proposed catalog item IDs (TEST or PACKAGE) — no FK, AI output

  // Order (embedded — one per case for MVP)
  orderNotes  String?
  orderSentAt DateTime?

  // Audit
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy            User              @relation(fields: [createdByUserId], references: [id])
  selectedCatalogItems CaseCatalogItem[]
  order                Order?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([createdByUserId])
  @@map("cases")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Single table for tests and packages, distinguished by kind.
/// Owned by one lab (labTenantId) — shared across all of that lab's connected
/// clinics, but isolated from every other lab's catalog.
/// Tests: code, category, turnaroundHours.
/// Packages: description + component tests via CatalogItemComposition.
model CatalogItem {
  id              String          @id @default(cuid())
  labTenantId     String
  kind            CatalogItemKind
  code            String? // TEST only — lab code (e.g. "CBC"); unique within the lab's catalog
  name            String
  description     String? // PACKAGE only
  category        String? // TEST only
  turnaroundHours Int? // TEST only
  resultType      ResultType? // TEST only — how to interpret the result value; null = unstructured
  unit            String? // TEST only — unit of measurement (e.g. "mg/dL", "K/µL"); null = unitless or not applicable
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  labTenant             Tenant                   @relation("LabCatalog", fields: [labTenantId], references: [id], onDelete: Cascade)
  components            CatalogItemComposition[] @relation("PackageComponents")
  packages              CatalogItemComposition[] @relation("ComponentPackages")
  caseCatalogItems      CaseCatalogItem[]
  orderedTests          OrderedTest[]
  orderedTestSources    OrderedTestSource[]      @relation("SourceOriginCatalogItem")
  labTestConfigurations LabTestConfiguration[]

  @@unique([labTenantId, code])
  @@index([kind])
  @@map("catalog_items")
}

/// Package → constituent TEST items (explicit many-to-many).
model CatalogItemComposition {
  packageId   String
  componentId String

  package   CatalogItem @relation("PackageComponents", fields: [packageId], references: [id], onDelete: Cascade)
  component CatalogItem @relation("ComponentPackages", fields: [componentId], references: [id], onDelete: Cascade)

  @@id([packageId, componentId])
  @@map("catalog_item_compositions")
}

/// Join table: vet-confirmed catalog item selection per case.
/// Using a proper relation (not String[]) for referential integrity and future analytics.
model CaseCatalogItem {
  caseId        String
  catalogItemId String

  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@id([caseId, catalogItemId])
  @@index([caseId])
  @@map("case_catalog_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// Monotonic counter used to generate human-readable requisition numbers.
/// Incremented atomically inside the same transaction that creates an Order.
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

/// A lab requisition created when a clinic sends an order.
/// orderedItems is a denormalized JSON snapshot of the catalog items at order
/// time — intentionally not a FK so history stays accurate if catalog changes.
model Order {
  id                String          @id @default(cuid())
  requisitionNumber String          @unique // REQ-2026-000001
  caseId            String          @unique // one active order per case (MVP)
  tenantId          String
  labTenantId       String? // which lab processes this order (null = platform direct for MVP seed)
  status            OrderStatus     @default(PENDING)
  priority          OrderPriority   @default(ROUTINE)
  deliveryMethod    DeliveryMethod?

  /// JSON snapshot: Array<{ catalogItemId, code, name, kind, category?, turnaroundHours? }>
  orderedItems Json

  clinicNotes String? // vet → lab
  labNotes    String? // internal lab use, not shown to clinic

  // Sample info — filled by lab/clinic staff
  sampleType  String? // BLOOD | URINE | FECES | SWAB | TISSUE | OTHER
  sampleNotes String?

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  collectedAt         DateTime?
  receivedByLabAt     DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  case           Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tenant         Tenant          @relation("ClinicOrders", fields: [tenantId], references: [id], onDelete: Cascade)
  labTenant      Tenant?         @relation("LabOrders", fields: [labTenantId], references: [id])
  resultReport   ResultReport?
  orderedTests   OrderedTest[]
  specimens      Specimen[]
  pickup         Pickup?
  timelineEvents TimelineEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([labTenantId])
  @@index([labTenantId, status])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Result Template Sections & Analytes (now owned by ResultTemplateVersion)
// ---------------------------------------------------------------------------

/// Named group of analytes within a template version (e.g. "Serie Roja", "Examen Macroscópico").
model ResultTemplateSection {
  id        String @id @default(cuid())
  versionId String
  code      String?
  name      String
  sortOrder Int

  version  ResultTemplateVersion   @relation("VersionSections", fields: [versionId], references: [id], onDelete: Cascade)
  analytes ResultTemplateAnalyte[]

  @@unique([versionId, code])
  @@map("result_template_sections")
}

/// One row in a result template version — defines what the lab tech fills in.
/// referenceRange JSON shape for MVP: { min?: number, max?: number, displayText: string }
model ResultTemplateAnalyte {
  id        String           @id @default(cuid())
  versionId String
  sectionId String? // null = template has no sections
  code      String // stable semantic key: "WBC", "HGB" — AI + machine import anchor
  name      String // display name: "Recuento total de leucocitos (WBC)"
  technique String? // "Impedancia eléctrica"
  valueType AnalyteValueType
  unit      String? // "10^3/µL" — null for qualitative analytes
  options   String[] // SELECT only — valid option values
  sortOrder Int
  isHeader  Boolean          @default(false) // bold label row — no value input, no flag
  formula   String? // e.g. "([HCT]*10)/[RBC]" — computed on frontend, read-only input

  /// MVP shape: { min?: number, max?: number, displayText: string }
  referenceRange Json?

  version        ResultTemplateVersion  @relation("VersionAnalytes", fields: [versionId], references: [id], onDelete: Cascade)
  section        ResultTemplateSection? @relation(fields: [sectionId], references: [id])
  reportAnalytes ResultReportAnalyte[]

  @@map("result_template_analytes")
}

// ---------------------------------------------------------------------------
// Template Versioning (Definition + Version replaces old ResultTemplate)
// ---------------------------------------------------------------------------

model ResultTemplateDefinition {
  id                 String         @id @default(cuid())
  catalogItemCode    String
  species            PatientSpecies
  ageMinWeeks        Int            @default(-1)
  ageMaxWeeks        Int            @default(-1)
  scope              TemplateScope  @default(PLATFORM)
  labTenantId        String?
  ownerKey           String
  parentDefinitionId String?
  activeVersionId    String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  labTenant        Tenant?                    @relation("LabTemplateDefinitions", fields: [labTenantId], references: [id])
  parentDefinition ResultTemplateDefinition?  @relation("TemplateInheritance", fields: [parentDefinitionId], references: [id])
  childDefinitions ResultTemplateDefinition[] @relation("TemplateInheritance")
  activeVersion    ResultTemplateVersion?     @relation("ActiveVersion", fields: [activeVersionId], references: [id])
  versions         ResultTemplateVersion[]    @relation("DefinitionVersions")
  reportTests      ResultReportTest[]

  @@unique([catalogItemCode, species, ageMinWeeks, ageMaxWeeks, ownerKey])
  @@index([ownerKey])
  @@index([catalogItemCode])
  @@map("result_template_definitions")
}

model ResultTemplateVersion {
  id                  String         @id @default(cuid())
  definitionId        String
  version             Int
  title               String
  status              TemplateStatus @default(DRAFT)
  defaultObservations String?
  observationPhrases  Json?
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())

  definition          ResultTemplateDefinition  @relation("DefinitionVersions", fields: [definitionId], references: [id], onDelete: Cascade)
  activeForDefinition ResultTemplateDefinition? @relation("ActiveVersion")
  sections            ResultTemplateSection[]   @relation("VersionSections")
  analytes            ResultTemplateAnalyte[]   @relation("VersionAnalytes")
  reportTests         ResultReportTest[]

  @@unique([definitionId, version])
  @@index([definitionId])
  @@map("result_template_versions")
}

// ---------------------------------------------------------------------------
// RAG Knowledge Base (global + tenant-scoped)
// ---------------------------------------------------------------------------

/// A knowledge document ingested into the RAG system.
/// tenantId = null → global shared knowledge (platform-owned).
/// tenantId = value → clinic/lab-specific knowledge (future).
model KnowledgeDocument {
  id         String         @id @default(cuid())
  tenantId   String? // null = global
  scope      KnowledgeScope @default(GLOBAL)
  title      String
  species    String? // 'dog' | 'cat' | null (species-agnostic)
  topic      String? // e.g. 'tick-borne', 'renal', 'parasites'
  sourceType String         @default("markdown") // 'markdown' | 'pdf' | 'manual'
  status     DocumentStatus @default(ACTIVE)
  filePath   String?        @unique // relative path — used for idempotent re-ingestion

  chunks    KnowledgeChunk[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId])
  @@index([species])
  @@map("knowledge_documents")
}

/// A text chunk from a knowledge document with a pgvector embedding.
/// One chunk = one section (H2 heading) of a markdown document.
/// embedding uses pgvector — requires the vector extension to be enabled in PostgreSQL.
model KnowledgeChunk {
  id           String                       @id @default(cuid())
  documentId   String
  tenantId     String? // denormalized from document for fast queries
  scope        KnowledgeScope               @default(GLOBAL)
  section      String // section heading (e.g. "CBC / Chemistry Patterns")
  content      String // section body text
  embedding    Unsupported("vector(1536)")? // OpenAI text-embedding-3-small (1536 dims)
  metadataJson Json? // { species, tags, analytes, documentId }

  document  KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([documentId])
  @@index([tenantId])
  @@index([scope, tenantId]) // supports future tenant-first + global fallback query
  @@map("knowledge_chunks")
}

// ---------------------------------------------------------------------------
// AI Interpretations (tenant-scoped, one per ResultReport)
// ---------------------------------------------------------------------------

/// AI-generated clinical interpretation of a released lab report.
/// Created on first request and cached — subsequent calls return the stored record.
/// promptVersion lets us track which prompt generated each interpretation.
model AiInterpretation {
  id                 String   @id @default(cuid())
  reportId           String
  lang               String   @default("en") // "en" | "es" — one record per report + language
  caseId             String // denormalized — fast case-scoped queries
  tenantId           String // denormalized — fast tenant scoping
  model              String // e.g. "claude-sonnet-4-6"
  promptVersion      String // e.g. "v1" — bump when prompt changes
  summary            String
  flaggedAnalytes    Json // AiInterpretationFlaggedAnalyte[]
  risks              Json // string[]
  suggestedNextSteps Json // string[]
  disclaimer         String
  generatedByUserId  String? // null when generated by async flow (future)
  retrievedChunkIds  String[] @default([]) // IDs of KnowledgeChunks used in RAG retrieval
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  report ResultReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, lang])
  @@index([tenantId])
  @@index([caseId])
  @@map("ai_interpretations")
}

// ---------------------------------------------------------------------------
// Result Reports (tenant-scoped, one per Order)
// ---------------------------------------------------------------------------

/// The actual filled lab result for an order.
/// One report per order. Template provenance is per-test via ResultReportTest.
/// DRAFT while the lab is entering values; RELEASED is final and visible to the clinic.
model ResultReport {
  id       String @id @default(cuid())
  orderId  String @unique // one structured report per order
  caseId   String // denormalized — fast case-scoped queries without Order join
  tenantId String // denormalized — fast tenant scoping

  status       ResultReportStatus @default(DRAFT)
  observations String? // lab's free-text note (maps to "Observaciones" on real reports)

  // Professional footer — filled when releasing the report
  processedByName        String?
  processedByRole        String?
  processedByCredentials String? // e.g. "Universidad Santiago de Cali"
  approvedByName         String?
  approvedByRole         String?
  approvedByCredentials  String? // e.g. "Universidad del Valle\nRegistro No.: 767658"
  signatureUrl           String? // approver signature image URL

  // Machine import hook — store raw analyzer payload for audit; mapping deferred
  rawPayload Json?

  // PDF export — generated from structured data on release; not source of truth
  pdfUrl String?

  releasedAt       DateTime?
  releasedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tests             ResultReportTest[]
  aiInterpretations AiInterpretation[]

  @@index([caseId])
  @@index([tenantId, status])
  @@map("result_reports")
}

/// Per-test template provenance within a result report.
/// Links each OrderedTest to the exact ResultTemplateVersion used for its analytes.
model ResultReportTest {
  id                   String   @id @default(cuid())
  reportId             String
  orderedTestId        String?
  templateVersionId    String
  templateDefinitionId String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  report             ResultReport             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  orderedTest        OrderedTest?             @relation(fields: [orderedTestId], references: [id])
  templateVersion    ResultTemplateVersion    @relation(fields: [templateVersionId], references: [id])
  templateDefinition ResultTemplateDefinition @relation(fields: [templateDefinitionId], references: [id])
  analytes           ResultReportAnalyte[]

  @@unique([reportId, orderedTestId])
  @@index([reportId])
  @@index([orderedTestId])
  @@map("result_report_tests")
}

/// One filled analyte row within a result report.
/// All display fields are denormalized snapshots so released results are stable
/// even if the source template is later edited.
model ResultReportAnalyte {
  id                String  @id @default(cuid())
  reportTestId      String
  templateAnalyteId String? // null when row comes from machine import with no template match

  // Snapshot fields — copied from template at report creation time
  code        String // "WBC" — the AI and cross-visit query anchor
  name        String
  technique   String?
  unit        String?
  valueType   AnalyteValueType
  sectionName String? // denormalized from section — render without extra joins
  sortOrder   Int
  isHeader    Boolean          @default(false)
  formula     String? // snapshot of formula — frontend uses this to auto-compute value

  // Typed value — exactly one is populated per non-header row
  numericValue Float?
  textValue    String?
  booleanValue Boolean? // POSITIVE_NEGATIVE
  selectValue  String? // SELECT

  // Semantic fields — computed on release and then frozen with the report
  // flag: "H" (High) | "L" (Low) | "N" (Normal) | null (non-numeric or no ref range)
  flag              String?
  referenceSnapshot Json? // snapshot of referenceRange at release time

  reportTest      ResultReportTest       @relation(fields: [reportTestId], references: [id], onDelete: Cascade)
  templateAnalyte ResultTemplateAnalyte? @relation(fields: [templateAnalyteId], references: [id])

  @@index([reportTestId])
  @@map("result_report_analytes")
}

// ---------------------------------------------------------------------------
// Lab Workflow (multi-tenant lab support)
// ---------------------------------------------------------------------------

/// Lab-specific settings for a tenant of type LAB or PLATFORM.
model LaboratoryProfile {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  accreditationNumber String?
  directorName        String?
  directorCredentials String?
  signatureUrl        String? // default signature image URL for released reports
  defaultObservations String? // default footer text pre-filled in result reports
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signers LabSigner[]

  @@map("laboratory_profiles")
}

model LabSigner {
  id                  String   @id @default(cuid())
  laboratoryProfileId String
  name                String
  roles               String[] // ANALYST, REVIEWER, DATA_ENTRY
  title               String   @default("")
  specialty           String   @default("")
  university          String   @default("")
  registrationNumber  String   @default("")
  signatureUrl        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  laboratoryProfile LaboratoryProfile @relation(fields: [laboratoryProfileId], references: [id], onDelete: Cascade)

  @@map("lab_signers")
}

/// Explicit connection between a clinic tenant and a lab tenant.
/// isDefault = true means this is the primary lab for the clinic (MVP: only one).
/// isActive = false allows soft-disabling without deleting the connection history.
model ClinicLabConnection {
  id        String   @id @default(cuid())
  clinicId  String
  labId     String
  isDefault Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Tenant @relation("ClinicConnections", fields: [clinicId], references: [id], onDelete: Cascade)
  lab    Tenant @relation("LabConnections", fields: [labId], references: [id], onDelete: Cascade)

  @@unique([clinicId, labId])
  @@index([clinicId])
  @@index([labId])
  @@map("clinic_lab_connections")
}

// ---------------------------------------------------------------------------
// Analyzers & Lab Test Configuration
// ---------------------------------------------------------------------------

model Analyzer {
  id             String     @id @default(cuid())
  labTenantId    String
  name           String
  model          String?
  manufacturer   String?
  department     Department
  connectionType String     @default("NONE")
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  labTenant             Tenant                 @relation("LabAnalyzers", fields: [labTenantId], references: [id], onDelete: Cascade)
  labTestConfigurations LabTestConfiguration[]
  orderedTests          OrderedTest[]

  @@unique([labTenantId, name])
  @@index([labTenantId])
  @@map("analyzers")
}

model LabTestConfiguration {
  id                       String             @id @default(cuid())
  labTenantId              String
  catalogItemId            String
  department               Department
  defaultProcessingMethod  ProcessingMethod   @default(MANUAL)
  allowedProcessingMethods ProcessingMethod[]
  defaultAnalyzerId        String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  labTenant            Tenant                       @relation("LabTestConfigs", fields: [labTenantId], references: [id], onDelete: Cascade)
  catalogItem          CatalogItem                  @relation(fields: [catalogItemId], references: [id])
  defaultAnalyzer      Analyzer?                    @relation(fields: [defaultAnalyzerId], references: [id])
  specimenRequirements LabTestSpecimenRequirement[]

  @@unique([labTenantId, catalogItemId])
  @@index([labTenantId])
  @@map("lab_test_configurations")
}

model LabTestSpecimenRequirement {
  id                       String  @id @default(cuid())
  labTestConfigurationId   String
  specimenType             String
  containerType            String
  minimumVolumeMl          Float?
  requirementGroupKey      String
  specimenRole             String?
  isAlternativeWithinGroup Boolean @default(false)
  notes                    String?
  sortOrder                Int     @default(0)

  labTestConfiguration LabTestConfiguration @relation(fields: [labTestConfigurationId], references: [id], onDelete: Cascade)

  @@index([labTestConfigurationId])
  @@map("lab_test_specimen_requirements")
}

/// One row per catalog item requested within an order.
/// Tracks per-test status and assignment independently of the overall order status.
/// Status is derived from aggregating these rows — never persisted on Order directly.
model OrderedTest {
  id            String @id @default(cuid())
  orderId       String
  catalogItemId String

  status      OrderedTestStatus @default(PENDING)
  entryMethod ResultEntryMethod @default(MANUAL)
  version     Int               @default(1)

  // Snapshot at order time — stable if catalog changes
  catalogItemCode String?
  catalogItemName String

  // Lab assignment
  assignedUserId String? // lab technician responsible for this test
  instrumentId   String? // analyzer / instrument used (future integration anchor)

  // Phase 3 fields
  department        Department?
  processingMethod  ProcessingMethod?
  resultEntrySource ResultEntrySource?
  analyzerId        String?
  claimedAt         DateTime?
  blockReason       BlockReason?
  blockReasonDetail String?

  receivedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem           @relation(fields: [catalogItemId], references: [id])
  assignedTo  User?                 @relation(fields: [assignedUserId], references: [id])
  analyzer    Analyzer?             @relation(fields: [analyzerId], references: [id])
  sources     OrderedTestSource[]
  reportTests ResultReportTest[]
  specimens   OrderedTestSpecimen[]

  @@index([orderId])
  @@index([catalogItemId])
  @@index([assignedUserId])
  @@map("ordered_tests")
}

/// Preserves every ordering/billing origin for a deduplicated OrderedTest.
/// A component test that appears in multiple packages (or both directly and via
/// a package) has multiple source rows — one per origin. The test itself exists once.
model OrderedTestSource {
  id                     String                @id @default(cuid())
  orderedTestId          String
  originCatalogItemId    String
  sourceType             OrderedTestSourceType
  originalOrderItemKey   String
  originalOrderItemIndex Int
  quantity               Int                   @default(1)
  originCode             String?
  originName             String
  createdAt              DateTime              @default(now())

  orderedTest       OrderedTest @relation(fields: [orderedTestId], references: [id], onDelete: Cascade)
  originCatalogItem CatalogItem @relation("SourceOriginCatalogItem", fields: [originCatalogItemId], references: [id])

  @@unique([orderedTestId, originalOrderItemKey, originCatalogItemId])
  @@index([orderedTestId])
  @@map("ordered_test_sources")
}

// ---------------------------------------------------------------------------
// Phase 3 — Specimen & Accessioning
// ---------------------------------------------------------------------------

/// A physical biological sample received at the lab for processing.
/// One specimen per tube (tubeIndex distinguishes multiple tubes of the same type).
model Specimen {
  id          String @id @default(cuid())
  orderId     String
  labTenantId String

  accessionNumber String // auto-generated: SPEC-{YEAR}-{6-digit-seq}, unique per lab
  specimenType    String // e.g. "EDTA_BLOOD", "SERUM", "URINE"
  containerType   String // e.g. "EDTA_TUBE", "SST_TUBE", "URINE_CUP"
  tubeIndex       Int    @default(1)

  status SpecimenStatus @default(EXPECTED)

  // Condition flags — multiple can be true simultaneously
  isHemolyzed      Boolean @default(false)
  isLipemic        Boolean @default(false)
  isIcteric        Boolean @default(false)
  isInsufficient   Boolean @default(false)
  isContaminated   Boolean @default(false)
  isWrongContainer Boolean @default(false)
  isLeaking        Boolean @default(false)

  receivedAt      DateTime?
  receivedById    String?
  rejectionReason String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy   User?                 @relation("SpecimensReceivedBy", fields: [receivedById], references: [id])
  orderedTests OrderedTestSpecimen[]

  @@unique([labTenantId, accessionNumber])
  @@index([orderId])
  @@index([labTenantId, status])
  @@map("specimens")
}

/// M:N link between ordered tests and the physical specimens used to run them.
model OrderedTestSpecimen {
  orderedTestId String
  specimenId    String

  orderedTest OrderedTest @relation(fields: [orderedTestId], references: [id], onDelete: Cascade)
  specimen    Specimen    @relation(fields: [specimenId], references: [id], onDelete: Cascade)

  @@id([orderedTestId, specimenId])
  @@map("ordered_test_specimens")
}

// ---------------------------------------------------------------------------
// Sample Collection & Pickup Workflow
// ---------------------------------------------------------------------------

/// Tracks the courier lifecycle for a LAB_PICKUP order, separate from Order.status.
/// One pickup per order — created automatically when the order's deliveryMethod is
/// LAB_PICKUP and the clinic has an active lab connection.
model Pickup {
  id             String        @id @default(cuid())
  orderId        String        @unique
  labTenantId    String
  clinicTenantId String
  status         PickupStatus  @default(REQUESTED)
  priority       OrderPriority @default(ROUTINE)

  // Snapshot of the clinic's collection settings at request time
  pickupAddress       String?
  pickupContactName   String?
  pickupContactPhone  String?
  pickupInstructions  String?
  requestedPickupTime DateTime?

  messengerId String? // User with MESSENGER role in labTenantId
  assignedAt  DateTime?

  // Web Push notification bookkeeping — no channel field, there's only one channel
  notifiedAt       DateTime?
  notifyFailReason String?

  acceptedAt  DateTime?
  collectedAt DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?
  failedAt    DateTime?
  failReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  labTenant      Tenant          @relation("LabPickups", fields: [labTenantId], references: [id])
  clinicTenant   Tenant          @relation("ClinicPickups", fields: [clinicTenantId], references: [id])
  messenger      User?           @relation("MessengerPickups", fields: [messengerId], references: [id])
  timelineEvents TimelineEvent[]

  @@index([labTenantId, status])
  @@index([messengerId, status])
  @@map("pickups")
}

/// A single audit/history entry rendered as the order's structured timeline —
/// replaces the ad-hoc "created / received / completed" timestamp display.
model TimelineEvent {
  id          String            @id @default(cuid())
  orderId     String
  pickupId    String?
  eventType   TimelineEventType
  actorId     String?
  actorName   String?
  description String
  metadata    Json?
  createdAt   DateTime          @default(now())

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pickup Pickup? @relation(fields: [pickupId], references: [id])

  @@index([orderId, createdAt])
  @@map("timeline_events")
}

/// A Web Push subscription for one browser/device of a lab user (typically a
/// MESSENGER). A user may have several — one per device/browser they've enabled
/// notifications on.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

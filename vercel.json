{
  "buildCommand": "node apps/frontend/scripts/write-sentry-env.js && npx nx build frontend --configuration=production && node apps/frontend/scripts/upload-sentry-sourcemaps.js",
  "outputDirectory": "dist/apps/frontend/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vet-ai-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
